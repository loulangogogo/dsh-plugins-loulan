{
  "name": "dsh-plugin-hello",
  "version": "0.1.0",
  "type": "module",
  "description": "注册 /hello 斜杠命令，在聊天界面输出「你好」",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "bash scripts/test-unit.sh",
    "prepack": "pnpm run build",
    "hello-pack": "pnpm pack",
    "release": "pnpm login && pnpm build && pnpm publish --no-git-checks"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-commands": "^0.1.5-rc.2"
  }
}
