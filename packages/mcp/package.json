{
  "name": "dsh-loulan-mcp",
  "version": "0.3.1",
  "type": "module",
  "description": "自动读取 .mcp.json（.dsh 根 + 工作区）并挂载其中的 MCP server",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "bash scripts/test-unit.sh",
    "mcp-pack": "pnpm pack",
    "release": "pnpm login && pnpm build && pnpm publish --no-git-checks"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-mcp-client": "0.1.2-rc.1",
    "@deepseek-ai/schemastery": "3.18.2"
  }
}
